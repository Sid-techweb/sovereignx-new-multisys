# SovereignX Environment Configuration Example
# Copy this file to .env and configure as needed

# Model Gateway Configuration
# Supported options: 'mock', 'ollama'
MODEL_PROVIDER=mock

# Ollama API URL (ignored if MODEL_PROVIDER=mock)
OLLAMA_BASE_URL=http://localhost:11434

# Specific local LLM name (optional for phase 1, e.g., llama3, qwen2.5, mistral)
MODEL_NAME=

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sovereignx
